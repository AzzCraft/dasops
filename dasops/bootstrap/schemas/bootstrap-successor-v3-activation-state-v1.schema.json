{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"bootstrap-successor-v3-activation-state/v1",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "schema":{"const":"bootstrap-successor-v3-activation-state/v1"},
    "recordDigest":{"$ref":"#/$defs/d"},
    "activationId":{"$ref":"#/$defs/id"},
    "registryId":{"$ref":"#/$defs/id"},
    "activationSlotDigest":{"$ref":"#/$defs/d"},
    "activationSubjectDigest":{"$ref":"#/$defs/d"},
    "rootEpoch":{"type":"integer","minimum":2},
    "rootDigest":{"$ref":"#/$defs/d"},
    "rotationHeadDigest":{"$ref":"#/$defs/d"},
    "adoptionReceiptDigest":{"$ref":"#/$defs/d"},
    "adoptionClosureVerificationReceiptDigest":{"$ref":"#/$defs/d"},
    "adoptionClosureVerifierAuthorityRef":{"type":"string","format":"uri","pattern":"^https://"},
    "adoptionClosureVerifiedAt":{"type":"string","format":"date-time"},
    "successorProfileDigest":{"$ref":"#/$defs/d"},
    "successorRegistryDigest":{"$ref":"#/$defs/d"},
    "taskLockV3Digest":{"$ref":"#/$defs/d"},
    "tokenHash":{"$ref":"#/$defs/d"},
    "activationGeneration":{"type":"integer","minimum":1},
    "adoptionState":{"const":"adopted"},
    "successorState":{"enum":["successor_inactive","active"]},
    "activationReceiptDigest":{"oneOf":[{"$ref":"#/$defs/d"},{"type":"null"}]},
    "updatedAt":{"type":"string","format":"date-time"}
  },
  "required":["schema","recordDigest","activationId","registryId","activationSlotDigest","activationSubjectDigest","rootEpoch","rootDigest","rotationHeadDigest","adoptionReceiptDigest","adoptionClosureVerificationReceiptDigest","adoptionClosureVerifierAuthorityRef","adoptionClosureVerifiedAt","successorProfileDigest","successorRegistryDigest","taskLockV3Digest","tokenHash","activationGeneration","adoptionState","successorState","activationReceiptDigest","updatedAt"],
  "oneOf":[
    {"properties":{"successorState":{"const":"successor_inactive"},"activationReceiptDigest":{"type":"null"}}},
    {"properties":{"successorState":{"const":"active"},"activationReceiptDigest":{"$ref":"#/$defs/d"}}}
  ],
  "$defs":{
    "d":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}
  }
}
