{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-claim-adoption-publication-recovery-receipt/v1",
  "oneOf": [
    {"$ref": "#/$defs/abort"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/ambiguous"}
  ],
  "$defs": {
    "d": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sigs": {
      "type": "array", "minItems": 4, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "keyFingerprint": {"$ref": "#/$defs/d"}, "identity": {"$ref": "#/$defs/id"},
          "role": {"enum": ["new_repository_owner", "old_repository_owner", "root_recovery", "security_recovery_owner"]},
          "algorithm": {"const": "ed25519"}, "signatureBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
          "signedAt": {"type": "string", "format": "date-time"}
        },
        "required": ["keyFingerprint", "identity", "role", "algorithm", "signatureBase64", "signedAt"]
      }
    },
    "common": {
      "schema": {"const": "bootstrap-claim-adoption-publication-recovery-receipt/v1"},
      "recordDigest": {"$ref": "#/$defs/d"}, "receiptId": {"$ref": "#/$defs/id"},
      "operationId": {"$ref": "#/$defs/id"}, "rootDigest": {"$ref": "#/$defs/d"},
      "packageId": {"$ref": "#/$defs/id"}, "packageDigest": {"$ref": "#/$defs/d"},
      "authorizationDigest": {"$ref": "#/$defs/d"}, "authorizationVerificationDigest": {"$ref": "#/$defs/d"},
      "operationHeadDigests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/d"}},
      "completedAt": {"type": "string", "format": "date-time"},
      "signatureSubjectDigest": {"$ref": "#/$defs/d"}, "signatures": {"$ref": "#/$defs/sigs"}
    },
    "commonRequired": {
      "type": "array",
      "const": ["schema", "recordDigest", "receiptId", "operationId", "rootDigest", "packageId", "packageDigest", "authorizationDigest", "authorizationVerificationDigest", "outcome", "operationHeadDigests", "completedAt", "signatureSubjectDigest", "signatures"]
    },
    "abort": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "bootstrap-claim-adoption-publication-recovery-receipt/v1"}, "recordDigest": {"$ref": "#/$defs/d"},
        "receiptId": {"$ref": "#/$defs/id"}, "operationId": {"$ref": "#/$defs/id"}, "rootDigest": {"$ref": "#/$defs/d"},
        "packageId": {"$ref": "#/$defs/id"}, "packageDigest": {"$ref": "#/$defs/d"},
        "authorizationDigest": {"$ref": "#/$defs/d"}, "authorizationVerificationDigest": {"$ref": "#/$defs/d"},
        "outcome": {"const": "abort"}, "operationHeadDigests": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/d"}},
        "branchClosureDigest": {"$ref": "#/$defs/d"}, "oldFenceReleaseDigest": {"$ref": "#/$defs/d"},
        "branchClosureValidationDigest": {"$ref": "#/$defs/d"},
        "newFenceReleaseDigest": {"$ref": "#/$defs/d"}, "authorityDenyReleaseDigest": {"$ref": "#/$defs/d"},
        "recoveryClosedHeadDigest": {"$ref": "#/$defs/d"}, "completedAt": {"type": "string", "format": "date-time"},
        "signatureSubjectDigest": {"$ref": "#/$defs/d"}, "signatures": {"$ref": "#/$defs/sigs"}
      },
      "required": ["schema", "recordDigest", "receiptId", "operationId", "rootDigest", "packageId", "packageDigest", "authorizationDigest", "authorizationVerificationDigest", "outcome", "operationHeadDigests", "branchClosureDigest", "branchClosureValidationDigest", "oldFenceReleaseDigest", "newFenceReleaseDigest", "authorityDenyReleaseDigest", "recoveryClosedHeadDigest", "completedAt", "signatureSubjectDigest", "signatures"]
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "bootstrap-claim-adoption-publication-recovery-receipt/v1"}, "recordDigest": {"$ref": "#/$defs/d"},
        "receiptId": {"$ref": "#/$defs/id"}, "operationId": {"$ref": "#/$defs/id"}, "rootDigest": {"$ref": "#/$defs/d"},
        "packageId": {"$ref": "#/$defs/id"}, "packageDigest": {"$ref": "#/$defs/d"},
        "authorizationDigest": {"$ref": "#/$defs/d"}, "authorizationVerificationDigest": {"$ref": "#/$defs/d"},
        "outcome": {"const": "success"}, "operationHeadDigests": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/d"}},
        "branchClosureDigest": {"$ref": "#/$defs/d"}, "oldPermanentFenceDigest": {"$ref": "#/$defs/d"},
        "branchClosureValidationDigest": {"$ref": "#/$defs/d"},
        "newFenceReleaseDigest": {"$ref": "#/$defs/d"}, "authorityDenyReleaseDigest": {"$ref": "#/$defs/d"},
        "recoveryClosedHeadDigest": {"$ref": "#/$defs/d"}, "completedAt": {"type": "string", "format": "date-time"},
        "signatureSubjectDigest": {"$ref": "#/$defs/d"}, "signatures": {"$ref": "#/$defs/sigs"}
      },
      "required": ["schema", "recordDigest", "receiptId", "operationId", "rootDigest", "packageId", "packageDigest", "authorizationDigest", "authorizationVerificationDigest", "outcome", "operationHeadDigests", "branchClosureDigest", "branchClosureValidationDigest", "oldPermanentFenceDigest", "newFenceReleaseDigest", "authorityDenyReleaseDigest", "recoveryClosedHeadDigest", "completedAt", "signatureSubjectDigest", "signatures"]
    },
    "ambiguous": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "bootstrap-claim-adoption-publication-recovery-receipt/v1"}, "recordDigest": {"$ref": "#/$defs/d"},
        "receiptId": {"$ref": "#/$defs/id"}, "operationId": {"$ref": "#/$defs/id"}, "rootDigest": {"$ref": "#/$defs/d"},
        "packageId": {"$ref": "#/$defs/id"}, "packageDigest": {"$ref": "#/$defs/d"},
        "authorizationDigest": {"$ref": "#/$defs/d"}, "authorizationVerificationDigest": {"$ref": "#/$defs/d"},
        "outcome": {"const": "ambiguous"}, "operationHeadDigests": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/d"}},
        "retainedOldFenceDigest": {"$ref": "#/$defs/d"}, "retainedNewFenceDigest": {"$ref": "#/$defs/d"},
        "retainedAuthorityDenyDigest": {"$ref": "#/$defs/d"}, "ambiguousHeadDigest": {"$ref": "#/$defs/d"},
        "completedAt": {"type": "string", "format": "date-time"}, "signatureSubjectDigest": {"$ref": "#/$defs/d"},
        "signatures": {"$ref": "#/$defs/sigs"}
      },
      "required": ["schema", "recordDigest", "receiptId", "operationId", "rootDigest", "packageId", "packageDigest", "authorizationDigest", "authorizationVerificationDigest", "outcome", "operationHeadDigests", "retainedOldFenceDigest", "retainedNewFenceDigest", "retainedAuthorityDenyDigest", "ambiguousHeadDigest", "completedAt", "signatureSubjectDigest", "signatures"]
    }
  }
}
