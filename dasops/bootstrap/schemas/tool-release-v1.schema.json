{
  "$id": "tool-release/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted tool release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recordDigest", "signatureSubjectDigest", "releaseId", "rootId", "rootEpoch", "version", "sourceDecisionDigest", "sourceCommit", "sourceTree", "sourceSubtree", "runtime", "wheel", "sourcePackage", "sbom", "provenance", "testEvidence", "status", "independentReviewStatus", "signatureStatus", "validFrom", "validUntil", "signatures"],
  "properties": {
    "schema": {"const": "tool-release/v1"},
    "recordDigest": {"$ref": "#/$defs/digest"},
    "signatureSubjectDigest": {"$ref": "#/$defs/digest"},
    "releaseId": {"$ref": "#/$defs/id"},
    "rootId": {"$ref": "#/$defs/id"},
    "rootEpoch": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:rc(0|[1-9][0-9]*))?$"},
    "sourceDecisionDigest": {"$ref": "#/$defs/digest"},
    "sourceCommit": {"$ref": "#/$defs/oid"},
    "sourceTree": {"$ref": "#/$defs/oid"},
    "sourceSubtree": {"$ref": "#/$defs/oid"},
    "runtime": {"$ref": "#/$defs/artifact"},
    "wheel": {"$ref": "#/$defs/artifact"},
    "sourcePackage": {"$ref": "#/$defs/artifact"},
    "sbom": {"$ref": "#/$defs/artifact"},
    "provenance": {"$ref": "#/$defs/artifact"},
    "testEvidence": {"$ref": "#/$defs/artifact"},
    "status": {"const": "accepted"},
    "independentReviewStatus": {"const": "accepted"},
    "signatureStatus": {"const": "signed"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "signatures": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 1}}
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["keyFingerprint", "identity", "role", "algorithm", "signatureBase64", "signedAt"],
      "properties": {
        "keyFingerprint": {"$ref": "#/$defs/digest"}, "identity": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 3}, "algorithm": {"const": "ed25519"},
        "signatureBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
