{
  "$id": "tool-source-decision/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted upstream tool source decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recordDigest", "signatureSubjectDigest", "decisionId", "rootId", "rootEpoch", "upstreamRepo", "upstreamBaseCommit", "changeId", "taskId", "governanceProfileDigest", "claimResultDigest", "reviewResultDigest", "gateResultDigest", "publicationReceiptDigest", "sourceCommit", "sourceTree", "sourceSubtree", "status", "validFrom", "validUntil", "signatures"],
  "properties": {
    "schema": {"const": "tool-source-decision/v1"},
    "recordDigest": {"$ref": "#/$defs/digest"},
    "signatureSubjectDigest": {"$ref": "#/$defs/digest"},
    "decisionId": {"$ref": "#/$defs/id"},
    "rootId": {"$ref": "#/$defs/id"},
    "rootEpoch": {"type": "integer", "minimum": 1},
    "upstreamRepo": {"type": "string", "minLength": 3},
    "upstreamBaseCommit": {"$ref": "#/$defs/oid"},
    "changeId": {"$ref": "#/$defs/id"},
    "taskId": {"$ref": "#/$defs/id"},
    "governanceProfileDigest": {"$ref": "#/$defs/digest"},
    "claimResultDigest": {"$ref": "#/$defs/digest"},
    "reviewResultDigest": {"$ref": "#/$defs/digest"},
    "gateResultDigest": {"$ref": "#/$defs/digest"},
    "publicationReceiptDigest": {"$ref": "#/$defs/digest"},
    "sourceCommit": {"$ref": "#/$defs/oid"},
    "sourceTree": {"$ref": "#/$defs/oid"},
    "sourceSubtree": {"$ref": "#/$defs/oid"},
    "status": {"const": "accepted"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "signatures": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["keyFingerprint", "identity", "role", "algorithm", "signatureBase64", "signedAt"],
      "properties": {
        "keyFingerprint": {"$ref": "#/$defs/digest"}, "identity": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 3}, "algorithm": {"const": "ed25519"},
        "signatureBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
