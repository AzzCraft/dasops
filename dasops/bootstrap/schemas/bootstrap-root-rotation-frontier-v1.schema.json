{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"bootstrap-root-rotation-frontier/v1",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "schema":{"const":"bootstrap-root-rotation-frontier/v1"},
    "recordDigest":{"$ref":"#/$defs/d"},
    "registryId":{"$ref":"#/$defs/id"},
    "rootDigest":{"$ref":"#/$defs/d"},
    "rootEpoch":{"type":"integer","minimum":1},
    "currentHeadDigest":{"$ref":"#/$defs/d"},
    "registrySequence":{"type":"integer","minimum":0},
    "attempts":{
      "type":"array",
      "maxItems":4096,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "properties":{
          "attemptId":{"$ref":"#/$defs/id"},
          "state":{"enum":["cancelled_pre_cas","adopted","compensated","abandoned","emergency_recovered"]},
          "entryDigest":{"$ref":"#/$defs/d"},
          "headDigest":{"$ref":"#/$defs/d"},
          "terminalClosureDigest":{"$ref":"#/$defs/d"},
          "tokenState":{"const":"disposed"},
          "writerState":{"const":"fenced"}
        },
        "required":["attemptId","state","entryDigest","headDigest","terminalClosureDigest","tokenState","writerState"]
      }
    },
    "capturedAt":{"type":"string","format":"date-time"}
  },
  "required":["schema","recordDigest","registryId","rootDigest","rootEpoch","currentHeadDigest","registrySequence","attempts","capturedAt"],
  "$defs":{
    "d":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}
  }
}
