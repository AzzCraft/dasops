{
  "$id": "protected-launch-descriptor/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argv": {"items": {"type": "string"}, "maxItems": 64, "type": "array"},
    "environment": {
      "additionalProperties": false,
      "properties": {
        "LANG": {"const": "C"},
        "LC_ALL": {"const": "C"},
        "PATH": {"const": "/usr/bin:/bin"},
        "PYTHONDONTWRITEBYTECODE": {"const": "1"}
      },
      "required": ["LANG", "LC_ALL", "PATH", "PYTHONDONTWRITEBYTECODE"],
      "type": "object"
    },
    "executablePath": {"minLength": 1, "type": "string"},
    "executableSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "materializationReceiptDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "maxOutputBytes": {"maximum": 10485760, "minimum": 1024, "type": "integer"},
    "passFds": {"items": {"minimum": 3, "type": "integer"}, "maxItems": 8, "type": "array", "uniqueItems": true},
    "recordDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "sandboxExecutablePath": {"const": "/usr/bin/bwrap"},
    "sandboxExecutableSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "sandboxProfile": {"const": "bwrap-readonly-workspace-v1"},
    "schema": {"const": "protected-launch-descriptor/v1"},
    "timeoutSeconds": {"maximum": 3600, "minimum": 1, "type": "integer"},
    "workingDirectory": {"minLength": 1, "type": "string"}
  },
  "required": ["schema", "recordDigest", "materializationReceiptDigest", "executablePath", "executableSha256", "sandboxExecutablePath", "sandboxExecutableSha256", "sandboxProfile", "workingDirectory", "argv", "environment", "passFds", "timeoutSeconds", "maxOutputBytes"],
  "title": "Protected digest-pinned launch descriptor v1",
  "type": "object"
}
