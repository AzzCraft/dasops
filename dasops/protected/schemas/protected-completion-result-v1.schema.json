{
  "$id": "protected-completion-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvalDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "baseCommit": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "candidateCommit": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "canonicalReadback": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "completedAt": {"format": "date-time", "type": "string"},
    "operationId": {"type": "string"},
    "outcome": {"enum": ["aborted_pre_cas", "published"], "type": "string"},
    "recordDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "requestDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "schema": {"const": "protected-completion-result/v1"},
    "verifiedRoleBindingsDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "verificationDigest": {
      "anyOf": [
        {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        {"type": "null"}
      ]
    },
    "workerLockDisposition": {"enum": ["deleted_with_filesystem_residuals_unclaimed", "retained_active"], "type": "string"}
  },
  "required": ["schema", "recordDigest", "operationId", "requestDigest", "outcome", "baseCommit", "candidateCommit", "canonicalReadback", "approvalDigest", "verificationDigest", "verifiedRoleBindingsDigest", "workerLockDisposition", "completedAt"],
  "title": "Protected completion result v1",
  "type": "object"
}
