{
  "$id": "protected-route-approval/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {"enum": ["abort", "publish"], "type": "string"},
    "approvalId": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"},
    "approvalSetDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "authorityRef": {"minLength": 1, "type": "string"},
    "canonicalHead": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "candidateCommit": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "expiresAt": {"format": "date-time", "type": "string"},
    "issuedAt": {"format": "date-time", "type": "string"},
    "recordDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "requestDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "requiredRoles": {
      "items": {"enum": ["task_governance", "verifier"], "type": "string"},
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {"const": "protected-route-approval/v1"}
  },
  "required": ["schema", "recordDigest", "approvalId", "authorityRef", "approvalSetDigest", "action", "requestDigest", "candidateCommit", "canonicalHead", "requiredRoles", "issuedAt", "expiresAt"],
  "title": "Protected route approval v1",
  "type": "object"
}
