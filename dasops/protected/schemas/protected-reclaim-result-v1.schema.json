{
  "$id": "protected-reclaim-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizationDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "baseCommit": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "candidateCommit": {"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$", "type": "string"},
    "changeId": {"type": "string"},
    "claimGeneration": {"minimum": 1, "type": "integer"},
    "claimOperationId": {"type": "string"},
    "leaseGeneration": {"minimum": 1, "type": "integer"},
    "operationId": {"type": "string"},
    "outcome": {"const": "reclaimed"},
    "priorOwner": {"type": "string"},
    "reclaimedAt": {"format": "date-time", "type": "string"},
    "recordDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "schema": {"const": "protected-reclaim-result/v1"},
    "taskId": {"type": "string"},
    "tokenHash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "verifiedRoleBindingsDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "workerLockDisposition": {"const": "deleted_with_filesystem_residuals_unclaimed"}
  },
  "required": [
    "schema",
    "recordDigest",
    "operationId",
    "claimOperationId",
    "changeId",
    "taskId",
    "priorOwner",
    "outcome",
    "tokenHash",
    "claimGeneration",
    "leaseGeneration",
    "baseCommit",
    "candidateCommit",
    "reclaimedAt",
    "authorizationDigest",
    "verifiedRoleBindingsDigest",
    "workerLockDisposition"
  ],
  "title": "Protected reclaim result v1",
  "type": "object"
}
