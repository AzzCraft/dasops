#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export REPO_ROOT

python3 - "$@" <<'PY'
from __future__ import annotations

import json
import argparse
import sys
try:
    import fcntl
except ImportError:
    fcntl = None
from contextlib import ExitStack
import os
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

import yaml


REPO_ROOT = Path(os.environ["REPO_ROOT"]).resolve()
REQUIRED_FILES = [
    REPO_ROOT / "docs" / "master_doc.md",
    REPO_ROOT / "docs" / "ui_spec.md",
    REPO_ROOT / "docs" / "USER_MANUAL.md",
    REPO_ROOT / "docs" / "policies" / "AGENT_OPERATING_MODEL.md",
    REPO_ROOT / "AGENTS.override.md",
    REPO_ROOT / "CLAUDE.md",
    REPO_ROOT / "STANDARD_REF.md",
    REPO_ROOT / "tooling_lock.json",
    REPO_ROOT / "local_extension_manifest.json",
    REPO_ROOT / "progress.txt",
    REPO_ROOT / "openspec" / "config.yaml",
    REPO_ROOT / "openspec" / "schemas" / "das-standard" / "schema.yaml",
    REPO_ROOT / "prompts" / "orchestrator.md",
    REPO_ROOT / "prompts" / "worker.md",
    REPO_ROOT / "scripts" / "run_worker_codex.sh",
    REPO_ROOT / "scripts" / "install_cadence_vendor.sh",
    REPO_ROOT / "cadencew",
    REPO_ROOT / "cadence.yaml",
    REPO_ROOT / "vendor" / "README.md",
]

LOCK_KEYS = {
    "version",
    "taskId",
    "owner",
    "status",
    "claimedAt",
    "updatedAt",
    "heartbeatAt",
    "leaseSeconds",
    "lockToken",
}
TASK_INDEX_HEADER = "| Task ID | Title | Owner | Status | Depends on | Verify gate |"
TASK_ALLOWED_STATUSES = {"TODO", "IN_PROGRESS", "DONE", "BLOCKED", "PROPOSED"}

TOOLING_LOCK_REQUIRED_KEYS = {"schemaVersion", "standardManifestVersion", "sourceOfTruth", "verifyRuntime"}
TOOLING_LOCK_REF_KEYS = {"kind", "uri", "pinType", "pinValue"}
EXTENSION_MANIFEST_REQUIRED_KEYS = {"schemaVersion", "standardManifestVersion", "extensions"}

LEGACY_BASELINE = "unified" + "-current-baseline"


def fail(message: str) -> int:
    print(f"[FAIL] {message}")
    return 1


def ok(message: str) -> None:
    print(f"[OK] {message}")


def check_exists() -> int:
    rc = 0
    for path in REQUIRED_FILES:
        if not path.exists():
            rc = 1
            print(f"[MISSING] {path.relative_to(REPO_ROOT)}")
        else:
            ok(f"exists: {path.relative_to(REPO_ROOT)}")
    return rc


def check_seed_contract() -> int:
    legacy = REPO_ROOT / "docs" / "standards" / "DAS_STANDARD.md"
    if legacy.exists():
        return fail("Found copied standard doc. Use STANDARD_REF.md instead.")

    cadence_yaml = (REPO_ROOT / "cadence.yaml").read_text(encoding="utf-8", errors="replace")
    if LEGACY_BASELINE in cadence_yaml:
        return fail(f"cadence.yaml still references {LEGACY_BASELINE}")
    if "core-v146-baseline" not in cadence_yaml:
        return fail("cadence.yaml must pin core-v146-baseline")

    config_text = (REPO_ROOT / "openspec" / "config.yaml").read_text(encoding="utf-8", errors="replace")
    if "STANDARD_REF.md" not in config_text:
        return fail("openspec/config.yaml must reference STANDARD_REF.md")

    ok("seed contract uses STANDARD_REF.md and v1.4.x artifacts")
    return 0


def check_master_doc_minimum() -> int:
    text = (REPO_ROOT / "docs" / "master_doc.md").read_text(encoding="utf-8", errors="replace")
    must_have_any = [
        ["Conformance profile"],
        ["Repo topology", "Topology"],
        ["Contracts"],
        ["Traceability"],
        ["Verification"],
        ["Execution plan"],
    ]
    missing = [alts[0] for alts in must_have_any if not any(candidate in text for candidate in alts)]
    if missing:
        return fail(f"docs/master_doc.md missing sections: {missing}")
    # Reject unresolved residue in master_doc
    for unresolved in ("TBD", "TODO", "PLACEHOLDER", "FIXME"):
        if unresolved in text:
            return fail(f"docs/master_doc.md contains unresolved residue: {unresolved!r}")
    ok("master_doc.md contains minimum headings")
    return 0


def check_deterministic_layout() -> int:
    stray_tasks = []
    for path in REPO_ROOT.rglob("tasks.md"):
        rel = path.relative_to(REPO_ROOT)
        if rel.parts[:2] == ("openspec", "schemas"):
            continue
        if rel.parts[:2] == ("openspec", "changes") and len(rel.parts) == 4 and rel.parts[3] == "tasks.md":
            continue
        stray_tasks.append(str(rel))
    if stray_tasks:
        return fail(
            "Found stray tasks.md files outside openspec/changes/<change-id>/tasks.md: "
            + ", ".join(stray_tasks)
        )

    legacy = [path for path in [REPO_ROOT / "docs" / "deltas", REPO_ROOT / "docs" / "delta"] if path.exists()]
    if legacy:
        return fail(
            "Legacy delta folders detected (use openspec/changes instead): "
            + ", ".join(str(path.relative_to(REPO_ROOT)) for path in legacy)
        )

    changes_dir = REPO_ROOT / "openspec" / "changes"
    if changes_dir.exists():
        for change_dir in sorted(path for path in changes_dir.iterdir() if path.is_dir()):
            tasks_md = change_dir / "tasks.md"
            if tasks_md.exists() and not (change_dir / "task_locks").exists():
                return fail(f"Missing task lock directory: {(change_dir / 'task_locks').relative_to(REPO_ROOT)}")

    ok("deterministic layout checks")
    return 0


class UniqueLockLoader(yaml.SafeLoader):
    pass


def unique_lock_mapping(loader, node):
    result = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node)
        if key in result:
            raise ValueError("duplicate task lock field")
        result[key] = loader.construct_object(value_node)
    return result


UniqueLockLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, unique_lock_mapping)


def check_task_lock_schema() -> int:
    changes_dir = REPO_ROOT / "openspec" / "changes"
    if not changes_dir.exists():
        return 0
    for lock_path in sorted(changes_dir.rglob("*.lock")):
        if not (lock_path.parent.parent / "tasks.md").is_file():
            return fail(f"Task lock has no task index: {lock_path.relative_to(REPO_ROOT)}")
        try:
            data = yaml.load(lock_path.read_text(encoding="utf-8"), Loader=UniqueLockLoader)
        except (ValueError, TypeError, yaml.YAMLError) as exc:
            return fail(f"Invalid task lock: {lock_path.relative_to(REPO_ROOT)} ({type(exc).__name__})")
        if not isinstance(data, dict):
            return fail(f"Lock is not a YAML object: {lock_path.relative_to(REPO_ROOT)}")
        missing = sorted(LOCK_KEYS - set(data))
        if missing:
            return fail(f"Lock missing required keys {missing}: {lock_path.relative_to(REPO_ROOT)}")
        if (set(data) - LOCK_KEYS - {"auditHistory"}
                or any(type(data[key]) is not int or data[key] < 1 for key in ("version", "leaseSeconds"))
                or any(not isinstance(data[key], str) or not data[key].strip()
                       for key in LOCK_KEYS - {"version", "leaseSeconds"})
                or data["taskId"] != lock_path.stem
                or not isinstance(data.get("auditHistory", []), list)
                or not all(isinstance(item, dict) for item in data.get("auditHistory", []))):
            return fail(f"Invalid task lock fields: {lock_path.relative_to(REPO_ROOT)}")
    ok("structured task lock checks")
    return 0


def check_tasks_index_contract() -> int:
    changes_dir = REPO_ROOT / "openspec" / "changes"
    if not changes_dir.exists():
        return 0
    for tasks_md in sorted(changes_dir.glob("*/tasks.md")):
        lines = tasks_md.read_text(encoding="utf-8", errors="replace").splitlines()
        if TASK_INDEX_HEADER not in lines:
            return fail(
                f"tasks.md missing canonical index header in {tasks_md.relative_to(REPO_ROOT)}"
            )
        header_idx = lines.index(TASK_INDEX_HEADER)
        tasks = {}
        for raw in lines[header_idx + 2 :]:
            stripped = raw.strip()
            if not stripped.startswith("|"):
                break
            if re.match(r"^\|\s*-{3,}", stripped):
                continue
            parts = [part.strip() for part in stripped.strip("|").split("|")]
            while len(parts) < 6:
                parts.append("")
            task_id, _title, owner, status, _depends_on, verify_gate = parts[:6]
            if not task_id:
                continue
            if task_id in tasks:
                return fail(f"Duplicate task ID {task_id} in {tasks_md.relative_to(REPO_ROOT)}")
            tasks[task_id] = (owner, status)
            if status not in TASK_ALLOWED_STATUSES:
                return fail(
                    f"tasks.md row {task_id} has invalid status {status!r} in {tasks_md.relative_to(REPO_ROOT)}"
                )
            if "verify" not in verify_gate:
                return fail(
                    f"tasks.md row {task_id} missing verify gate command in {tasks_md.relative_to(REPO_ROOT)}"
                )
        lock_dir = tasks_md.parent / "task_locks"
        if lock_dir.is_symlink():
            return fail("Invalid task lock directory")
        locked = set()
        for lock_path in sorted(lock_dir.glob("*.lock")):
            data = yaml.load(lock_path.read_text(encoding="utf-8"), Loader=UniqueLockLoader)
            task_id = data["taskId"]
            if tasks.get(task_id) != (data["owner"], data["status"]):
                return fail(f"Inconsistent task state: {lock_path.relative_to(REPO_ROOT)}")
            locked.add(task_id)
        if any(status == "IN_PROGRESS" and task_id not in locked
               for task_id, (_, status) in tasks.items()):
            return fail(f"IN_PROGRESS task missing lock: {tasks_md.relative_to(REPO_ROOT)}")
    ok("tasks.md column/status contract checks")
    return 0


def check_stale_lock_semantics() -> int:
    changes_dir = REPO_ROOT / "openspec" / "changes"
    if not changes_dir.exists():
        return 0
    now = datetime.now(timezone.utc)
    for lock_path in sorted(changes_dir.rglob("*.lock")):
        data = yaml.safe_load(lock_path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return fail(f"Lock is not a YAML object: {lock_path.relative_to(REPO_ROOT)}")

        lease_seconds = int(data.get("leaseSeconds", 0))
        if lease_seconds <= 0:
            return fail(f"Lock leaseSeconds must be > 0: {lock_path.relative_to(REPO_ROOT)}")

        status = str(data.get("status", "")).strip()
        if status not in TASK_ALLOWED_STATUSES:
            return fail(f"Lock has invalid status {status!r}: {lock_path.relative_to(REPO_ROOT)}")

        try:
            claimed = datetime.fromisoformat(str(data.get("claimedAt", "")))
            updated = datetime.fromisoformat(str(data.get("updatedAt", "")))
            heartbeat = datetime.fromisoformat(str(data.get("heartbeatAt", "")))
        except ValueError:
            return fail(f"Lock has invalid timestamp fields: {lock_path.relative_to(REPO_ROOT)}")

        if claimed.tzinfo is None:
            claimed = claimed.replace(tzinfo=timezone.utc)
        if updated.tzinfo is None:
            updated = updated.replace(tzinfo=timezone.utc)
        if heartbeat.tzinfo is None:
            heartbeat = heartbeat.replace(tzinfo=timezone.utc)

        if updated < claimed:
            return fail(f"Lock updatedAt precedes claimedAt: {lock_path.relative_to(REPO_ROOT)}")
        if heartbeat < claimed:
            return fail(f"Lock heartbeatAt precedes claimedAt: {lock_path.relative_to(REPO_ROOT)}")

        if status == "IN_PROGRESS" and (now - heartbeat).total_seconds() > lease_seconds:
            return fail(f"Stale IN_PROGRESS lock detected: {lock_path.relative_to(REPO_ROOT)}")

    ok("stale/reclaim lock lifecycle semantics")
    return 0


def check_tooling_lock_schema() -> int:
    path = REPO_ROOT / "tooling_lock.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, ValueError) as exc:
        return fail(f"tooling_lock.json is not valid JSON: {exc}")
    if not isinstance(data, dict):
        return fail("tooling_lock.json root must be an object")
    missing = sorted(TOOLING_LOCK_REQUIRED_KEYS - set(data))
    if missing:
        return fail(f"tooling_lock.json missing required keys: {missing}")
    for ref_key in ("sourceOfTruth", "verifyRuntime"):
        ref = data.get(ref_key)
        if not isinstance(ref, dict):
            return fail(f"tooling_lock.json {ref_key} must be an object")
        if (
            ref_key == "sourceOfTruth"
            and str(ref.get("pinState", "")).lower() == "pending"
            and not ref.get("pinValue")
        ):
            return fail("tooling_lock.json sourceOfTruth.pinState is pending; sourceOfTruth.pinValue must be a real git commit before verify can pass")
        ref_missing = sorted(TOOLING_LOCK_REF_KEYS - set(ref))
        if ref_missing:
            return fail(f"tooling_lock.json {ref_key} missing keys: {ref_missing}")
    # Reject unresolved pinValue in sourceOfTruth
    sot = data.get("sourceOfTruth", {})
    pin_type = str(sot.get("pinType", "")).strip()
    pin = str(sot.get("pinValue", "")).strip()
    if sot.get("kind") == "git" and pin_type not in {"commit", "tag"}:
        return fail(f"tooling_lock.json sourceOfTruth.pinType must be commit or tag: {pin_type!r}")
    unresolved_pins = ("replace-with-product-commit", "fake-sha256", "TBD", "TODO", "PLACEHOLDER", "")
    if pin.lower() in (p.lower() for p in unresolved_pins):
        return fail(f"tooling_lock.json sourceOfTruth.pinValue is unresolved: {pin!r}")
    if pin_type == "commit" and not re.fullmatch(r"[0-9a-f]{7,40}", pin):
        return fail(f"tooling_lock.json sourceOfTruth.pinValue must be a git commit hash: {pin!r}")
    ok("tooling_lock.json schema validated")
    return 0


def check_extension_manifest_schema() -> int:
    path = REPO_ROOT / "local_extension_manifest.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, ValueError) as exc:
        return fail(f"local_extension_manifest.json is not valid JSON: {exc}")
    if not isinstance(data, dict):
        return fail("local_extension_manifest.json root must be an object")
    missing = sorted(EXTENSION_MANIFEST_REQUIRED_KEYS - set(data))
    if missing:
        return fail(f"local_extension_manifest.json missing required keys: {missing}")
    if not isinstance(data.get("extensions"), list):
        return fail("local_extension_manifest.json extensions must be an array")
    ok("local_extension_manifest.json schema validated")
    return 0


def maybe_run_cadence() -> int:
    cadence_dir = REPO_ROOT / "vendor" / "cadence"
    cadencew = REPO_ROOT / "cadencew"
    if cadence_dir.exists() and cadencew.exists():
        print("\n[CADENCE] vendor/cadence detected; running cadence verify --profile dev")
        process = subprocess.run(["./cadencew", "verify", "--profile", "dev"], cwd=str(REPO_ROOT))
        if process.returncode != 0:
            return fail("Cadence verify failed")
    return 0


def _checks(frontend: bool) -> int:
    rc = 0
    rc |= check_exists()
    if rc != 0:
        return rc
    rc |= check_seed_contract()
    rc |= check_deterministic_layout()
    rc |= check_task_lock_schema()
    if rc != 0:
        return rc
    rc |= check_tasks_index_contract()
    rc |= check_stale_lock_semantics()
    rc |= check_tooling_lock_schema()
    rc |= check_extension_manifest_schema()
    rc |= check_master_doc_minimum()
    config = yaml.safe_load((REPO_ROOT / "cadence.yaml").read_text())
    if not isinstance(config, dict) or not isinstance(config.get("ui", {}), dict):
        return fail("cadence.yaml ui must be an object")
    enabled = config.get("ui", {}).get("enabled", False)
    if type(enabled) is not bool:
        return fail("cadence.yaml ui.enabled must be boolean")
    if frontend or enabled:
        child = subprocess.run([sys.executable, str(REPO_ROOT / "scripts/verify_frontend_evidence.py")], cwd=REPO_ROOT)
        rc |= child.returncode
    else:
        ok("frontend evidence not applicable (legacy ui.enabled=false)")
    return rc


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--frontend", action="store_true")
    args = parser.parse_args()
    # Same stable guard inode as DASOps writers; no read-side recovery.
    with ExitStack() as stack:
        for tasks in sorted((REPO_ROOT / "openspec/changes").glob("*/tasks.md")):
            if fcntl is None:
                return fail("unsupported task coordination platform")
            meta = tasks.parent / ".dasops-local"
            if meta.is_symlink():
                return fail("invalid task coordination directory")
            meta.mkdir(mode=0o700, exist_ok=True)
            fd = os.open(meta / "coordination.guard", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            stream = stack.enter_context(os.fdopen(fd, "r+b"))
            fcntl.flock(stream.fileno(), fcntl.LOCK_SH)
            if os.path.lexists(meta / "pending.json"):
                return fail("task state recovery_required; resume a DASOps writer before verification")
        rc = _checks(args.frontend)
    # Only snapshot reads need the shared guard. External verification must
    # allow heartbeats/writers; complete-task rechecks its subject before DONE.
    if rc == 0:
        rc = maybe_run_cadence()
    if rc == 0:
        print("\nAll verify checks passed.")
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
PY
