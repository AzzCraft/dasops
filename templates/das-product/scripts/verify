#!/usr/bin/env python3
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

REQUIRED_FILES = [
    REPO_ROOT / "docs" / "master_doc.md",
    REPO_ROOT / "docs" / "ui_spec.md",
    REPO_ROOT / "docs" / "USER_MANUAL.md",
    REPO_ROOT / "docs" / "policies" / "AGENT_OPERATING_MODEL.md",
    REPO_ROOT / "AGENTS.override.md",
    REPO_ROOT / "CLAUDE.md",
    REPO_ROOT / "progress.txt",
    REPO_ROOT / "openspec" / "config.yaml",
    REPO_ROOT / "openspec" / "schemas" / "das-standard" / "schema.yaml",
    REPO_ROOT / "prompts" / "orchestrator.md",
    REPO_ROOT / "prompts" / "worker.md",
    REPO_ROOT / "scripts" / "run_worker_codex.sh",
    REPO_ROOT / "scripts" / "install_cadence_vendor.sh",
    REPO_ROOT / "cadencew",
    REPO_ROOT / "cadence.yaml",
    REPO_ROOT / "vendor" / "README.md",
]


def fail(msg: str) -> int:
    print(f"[FAIL] {msg}")
    return 1


def ok(msg: str) -> None:
    print(f"[OK] {msg}")


def check_exists() -> int:
    rc = 0
    for f in REQUIRED_FILES:
        if not f.exists():
            rc = 1
            print(f"[MISSING] {f.relative_to(REPO_ROOT)}")
        else:
            ok(f"exists: {f.relative_to(REPO_ROOT)}")
    return rc


def check_master_doc_minimum() -> int:
    """Very lightweight sanity checks.

    Each real project SHOULD harden these checks (e.g., enforce traceability rows, verify gates, etc.).
    """
    p = REPO_ROOT / "docs" / "master_doc.md"
    text = p.read_text(encoding="utf-8", errors="replace")
    must_have_any = [
        ["Conformance profile"],
        ["Repo topology", "Topology"],
        ["Contracts"],
        ["Traceability"],
        ["Verification"],
        ["Execution plan"],
    ]
    missing = [alts[0] for alts in must_have_any if not any(a in text for a in alts)]
    if missing:
        return fail(f"docs/master_doc.md missing sections: {missing}")
    ok("master_doc.md contains minimum headings")
    return 0


def check_deterministic_layout() -> int:
    """Enforce stable artifact locations.

    Motivation: many AI tools will "helpfully" create new folders/files with
    slightly different names. In multi-agent environments, that quickly becomes
    chaos. This check intentionally prefers false positives over false negatives.
    """
    # 1) No stray tasks.md outside openspec/changes/*/tasks.md
    stray_tasks = []
    for p in REPO_ROOT.rglob("tasks.md"):
        rel = p.relative_to(REPO_ROOT)
        # Allow schema templates
        if rel.parts[:2] == ("openspec", "schemas"):
            continue
        if rel.parts[:2] == ("openspec", "changes") and len(rel.parts) == 4 and rel.parts[3] == "tasks.md":
            continue
        stray_tasks.append(str(rel))
    if stray_tasks:
        return fail(
            "Found stray tasks.md files outside openspec/changes/<change-id>/tasks.md: "
            + ", ".join(stray_tasks)
        )

    # 2) No legacy delta folders (we standardize on openspec/changes)
    legacy = [p for p in [REPO_ROOT / "docs" / "deltas", REPO_ROOT / "docs" / "delta"] if p.exists()]
    if legacy:
        rels = [str(p.relative_to(REPO_ROOT)) for p in legacy]
        return fail(
            "Legacy delta folders detected (use openspec/changes instead): " + ", ".join(rels)
        )

    # 3) Each change that has tasks.md must also have a task_locks directory
    changes_dir = REPO_ROOT / "openspec" / "changes"
    if changes_dir.exists():
        for d in sorted([p for p in changes_dir.iterdir() if p.is_dir()]):
            tasks = d / "tasks.md"
            if tasks.exists():
                lock_dir = d / "task_locks"
                if not lock_dir.exists():
                    return fail(f"Missing task lock directory: {lock_dir.relative_to(REPO_ROOT)}")

    ok("deterministic layout checks")
    return 0


def check_task_locks_layout() -> int:
    changes_dir = REPO_ROOT / "openspec" / "changes"
    if not changes_dir.exists():
        return 0

    for change_dir in sorted([p for p in changes_dir.iterdir() if p.is_dir()]):
        tasks_md = change_dir / "tasks.md"
        if not tasks_md.exists():
            continue
        lock_dir = change_dir / "task_locks"
        if not lock_dir.exists():
            return fail(f"Missing task_locks for change: {change_dir.name}")
    ok("task lock folder checks")
    return 0


def main() -> int:
    rc = 0
    rc |= check_exists()
    if rc != 0:
        return rc
    rc |= check_deterministic_layout()
    rc |= check_task_locks_layout()
    rc |= check_master_doc_minimum()
    # Optional Cadence gate.
    # If Cadence is vendored under vendor/cadence, run it as an additional deterministic verifier.
    if rc == 0:
        cadence_dir = REPO_ROOT / "vendor" / "cadence"
        cadencew = REPO_ROOT / "cadencew"
        if cadence_dir.exists() and cadencew.exists():
            import subprocess

            print("\n[CADENCE] vendor/cadence detected; running cadence verify --profile dev")
            p = subprocess.run(["./cadencew", "verify", "--profile", "dev"], cwd=str(REPO_ROOT))
            if p.returncode != 0:
                return fail("Cadence verify failed")
    if rc == 0:
        print("\nAll verify checks passed.")
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
