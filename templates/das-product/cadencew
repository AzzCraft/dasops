#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$ROOT_DIR/.cadence/bin"
BIN="$BIN_DIR/cadence"

ensure_bin() {
  VENDOR_CORE="$ROOT_DIR/vendor/cadence/cadence-oss/cadence-core"
  if [[ -d "$VENDOR_CORE" ]]; then
    mkdir -p "$BIN_DIR"
    echo "cadencew: checking/building cadence-core -> $BIN" >&2
    (cd "$VENDOR_CORE" && go build -o "$BIN" ./cmd/cadence)
    return 0
  fi
  # A leftover source-built binary is not an installed/pinned global binary.
  if command -v cadence >/dev/null 2>&1; then
    exec cadence "$@"
  fi
  echo "cadencew: install Cadence under vendor/cadence or install cadence globally" >&2
  return 127
}

ensure_bin "$@"

if [[ -x "$BIN" ]]; then
  exec "$BIN" "$@"
else
  exec cadence "$@"
fi
