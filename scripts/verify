#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
export PYTEST_ADDOPTS=

# Release preparation supplies an exact lock in an isolated environment.
# Direct development runs may reuse installed supported dependencies; if a
# required dependency is absent, provision the verification lock outside the tree.
# Importability alone is not an exact-lock qualification claim.
if [[ "${DASOPS_VERIFY_ENV_READY:-}" != "1" ]]; then
  if ! python3 - <<'PY' >/dev/null 2>&1
import jsonschema
import pytest
import pytest_timeout
import rfc8785
import rfc3339_validator
import yaml
PY
  then
    verify_environment="$(mktemp -d "${TMPDIR:-/tmp}/dasops-verify.XXXXXX")"
    cleanup_verify_environment() {
      rm -rf "$verify_environment"
    }
    trap cleanup_verify_environment EXIT
    python3 -m venv "$verify_environment"
    "$verify_environment/bin/python" -m pip install --disable-pip-version-check --no-input -r requirements-verify.txt
    DASOPS_VERIFY_ENV_READY=1 PATH="$verify_environment/bin:$PATH" bash "$0" "$@"
    exit $?
  fi
fi

python3 -m dasops --help >/dev/null
python3 -m dasops doctor --help >/dev/null
python3 -m dasops audit --help >/dev/null
python3 -m dasops standards search --help >/dev/null
python3 -m dasops standards show --help >/dev/null
python3 -m dasops standards pack --help >/dev/null
python3 -m dasops template-audit --help >/dev/null
python3 -m dasops prompt --help >/dev/null
python3 -m dasops create --help >/dev/null
python3 -m dasops lock-status --help >/dev/null
python3 -m dasops govern --help >/dev/null

python3 -m dasops template-audit --repo-root "$ROOT" --json >/dev/null
export DAS_STANDARD_ROOT="$ROOT/tests/fixtures/standard-indexes"

manifest="tests/verification_manifest.json"
test -f "$manifest" || {
  echo "missing verification manifest: $manifest" >&2
  exit 1
}
mapfile -t public_test_paths < <(python3 - "$manifest" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
minimum = payload.get("minimumCollectedTests")
if not isinstance(minimum, int) or minimum < 1:
    raise SystemExit("verification manifest minimumCollectedTests must be a positive integer")
paths = payload.get("publicTestPaths")
if not isinstance(paths, list) or not paths or not all(isinstance(path, str) for path in paths):
    raise SystemExit("verification manifest publicTestPaths must be a non-empty string array")
if len(paths) != len(set(paths)):
    raise SystemExit("verification manifest publicTestPaths must not contain duplicates")
for path in paths:
    if not path.startswith("tests/"):
        raise SystemExit(f"verification manifest contains a non-public test path: {path}")
    print(path)
PY
)
minimum_collected_tests="$(python3 - "$manifest" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
print(payload["minimumCollectedTests"])
PY
)"
if ((${#public_test_paths[@]} == 0)); then
  echo "verification manifest selected no public test paths" >&2
  exit 1
fi
collection_output="$(mktemp)"
trap 'rm -f "$collection_output"' EXIT
python3 -m pytest --collect-only -q -p no:cacheprovider -p timeout "${public_test_paths[@]}" >"$collection_output"
collected_tests="$(sed -nE 's/^([0-9]+) tests collected.*$/\1/p' "$collection_output" | tail -n 1)"
if [[ -z "$collected_tests" || "$collected_tests" -lt "$minimum_collected_tests" ]]; then
  printf 'pytest collection fell below the required floor: observed=%s required=%s\n' \
    "${collected_tests:-unknown}" "$minimum_collected_tests" >&2
  cat "$collection_output" >&2
  exit 1
fi

# A bounded per-test timeout turns a stalled integration fixture into an
# actionable failure; the outer timeout bounds the complete verifier in CI.
timeout --preserve-status 30m python3 -m pytest -q -p no:cacheprovider -p timeout \
  --timeout=90 --timeout-method=signal "${public_test_paths[@]}"

python3 - <<'PY'
from pathlib import Path
import re
import sys

root = Path.cwd()
legacy_baseline = "unified" + "-current-baseline"
legacy_enterprise = "cadence-forge" + "-enterprise"
legacy_installer = "submodule " + "https://github.com/<org>/cadence.git"
legacy_python_launcher = re.compile(r"(?<![A-Za-z0-9_])python -m(?: pip)?\b")

problems = []
governed_launcher_surfaces = {
    Path("README.md"),
    Path("docs/USER_MANUAL.md"),
    Path("templates/das-product/README.md"),
    Path("Makefile"),
}

for path in root.rglob("*"):
    if ".git" in path.parts or not path.is_file():
        continue
    rel = path.relative_to(root)
    if rel.as_posix().endswith("docs/standards/DAS_STANDARD.md"):
        problems.append(f"copied standard doc remains: {rel}")
        continue
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        continue
    if legacy_baseline in text:
        problems.append(f"legacy baseline reference remains: {rel}")
    if legacy_enterprise in text:
        problems.append(f"legacy enterprise path remains: {rel}")
    if legacy_installer in text:
        problems.append(f"legacy installer usage remains: {rel}")
    if rel in governed_launcher_surfaces and legacy_python_launcher.search(text):
        problems.append(f"bare python launcher remains in governed surface: {rel}")

if problems:
    print("\n".join(problems), file=sys.stderr)
    raise SystemExit(1)
PY

mapfile -t RESIDUE < <(find "$ROOT" -path '*/.git' -prune -o \( -type d -name '__pycache__' -o -type f \( -name '*.pyc' -o -name '.DS_Store' \) \) -print)
if ((${#RESIDUE[@]})); then
  printf 'forbidden generated residue found:\n' >&2
  printf '%s\n' "${RESIDUE[@]}" >&2
  exit 1
fi
